<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>توصيلة</title>
<style>
:root{--bg:#f4f4f2;--card:#fff;--tx:#111;--mu:#6b6b6b;--bd:#e2e2de;--ac:#111;--ac2:#fff;--er:#d93a3a}
@media(prefers-color-scheme:dark){:root{--bg:#121212;--card:#1e1e1e;--tx:#f2f2f2;--mu:#9a9a9a;--bd:#333;--ac:#fff;--ac2:#111}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Tahoma,Arial,sans-serif;max-width:520px;margin-inline:auto}
[hidden]{display:none!important}
header{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:var(--card);border-bottom:1px solid var(--bd)}
button,input{font-family:inherit;font-size:16px;padding:12px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);width:100%}
button{cursor:pointer}.p{background:var(--ac);color:var(--ac2);font-weight:700;border:0}
.sheet{background:var(--card);padding:16px;display:grid;gap:8px}
label{font-size:12px;color:var(--mu)}
.seg{display:flex;gap:6px}.seg button.on{background:var(--ac);color:var(--ac2)}
#map{height:280px;background:#e8ece6;display:flex;align-items:center;justify-content:center;color:var(--mu);padding:12px;text-align:center}
.card{display:flex;gap:10px;align-items:center;border:1px solid var(--bd);border-radius:12px;padding:12px;justify-content:space-between}
.card.on{border:2px solid var(--ac)}
.er{color:var(--er);font-size:13px;min-height:18px}
.info{display:flex;justify-content:space-between;color:var(--mu);font-size:13px}
.sm{width:auto;padding:8px 14px}
</style>
</head>
<body>
<header id="bar" hidden><span id="who"></span><button id="out" class="sm">خروج</button></header>

<main id="auth" class="sheet" style="min-height:100vh">
  <h1 style="text-align:center">🚗 توصيلة</h1>
  <div class="seg"><button data-r="customer">عميل</button><button data-r="driver">سائق</button></div>
  <div class="seg"><button data-m="in">دخول</button><button data-m="up">حساب جديد</button></div>
  <div id="fn"><label>الاسم</label><input id="nm" autocomplete="name"></div>
  <label>رقم الموبايل</label><input id="ph" type="tel" inputmode="numeric" placeholder="01xxxxxxxxx" autocomplete="tel">
  <div id="fc"><label>نوع العربية</label><input id="cr"></div>
  <label>الباسورد</label><input id="pw" type="password" autocomplete="current-password">
  <div class="er" id="err"></div>
  <button class="p" id="sub"></button>
</main>

<main id="cust" hidden>
  <div id="map">جاري تحميل الخريطة…</div>
  <section class="sheet">
    <div id="book" class="sheet" style="padding:0">
      <label>من</label><input id="from" placeholder="مثال: ميدان التحرير، القاهرة">
      <label>إلى</label><input id="to" placeholder="مثال: مطار القاهرة">
      <button id="calc">اعرض المسار والأسعار</button>
      <div id="rides"></div>
      <div class="info"><span id="dist"></span><span id="eta"></span></div>
      <div class="er" id="cerr"></div>
      <button class="p" id="req" disabled>اطلب رحلة</button>
    </div>
    <div id="status" hidden></div>
  </section>
</main>

<main id="drv" hidden class="sheet" style="min-height:100vh">
  <h1>لوحة الكابتن</h1>
  <div class="info"><span>أرباحك</span><b id="earn"></b></div>
  <div id="dl" class="sheet" style="padding:0"></div>
</main>

<script>
const $ = (i) => document.getElementById(i);
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const PR = { economy: [15, 6, "اقتصادي", "🚗"], comfort: [25, 8, "مريح", "🚙"], vip: [40, 12, "VIP", "🚘"] };
let token = localStorage.getItem("tk"), me = null, role = "customer", mode = "in", type = "economy", route = null, poll = null;
let gmap, Route, lines = [], cfg = {};

async function api(p, m = "GET", b) {
  const r = await fetch("/api" + p, {
    method: m,
    headers: { "Content-Type": "application/json", ...(token ? { Authorization: "Bearer " + token } : {}) },
    body: b ? JSON.stringify(b) : undefined,
  });
  const d = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(d.error || "حصل خطأ");
  return d;
}

// ---------- تسجيل الدخول ----------
function tabs() {
  document.querySelectorAll("[data-r]").forEach((b) => b.classList.toggle("on", b.dataset.r === role));
  document.querySelectorAll("[data-m]").forEach((b) => b.classList.toggle("on", b.dataset.m === mode));
  $("fn").hidden = mode !== "up";
  $("fc").hidden = !(mode === "up" && role === "driver");
  $("sub").textContent = mode === "in" ? "دخول" : "إنشاء حساب";
  $("err").textContent = "";
}
$("auth").onclick = (e) => {
  const b = e.target.closest("button");
  if (!b) return;
  if (b.dataset.r) role = b.dataset.r;
  if (b.dataset.m) mode = b.dataset.m;
  tabs();
};
$("sub").onclick = async () => {
  try {
    const d = await api(mode === "in" ? "/login" : "/register", "POST",
      { role, name: $("nm").value, phone: $("ph").value.trim(), password: $("pw").value, car: $("cr").value });
    token = d.token; localStorage.setItem("tk", token); enter(d.user);
  } catch (e) { $("err").textContent = e.message; }
};
$("out").onclick = () => { localStorage.removeItem("tk"); location.reload(); };

function enter(u) {
  me = u;
  $("auth").hidden = true; $("bar").hidden = false;
  $("who").textContent = (u.role === "driver" ? "🚖 كابتن " : "👤 ") + u.name;
  $("cust").hidden = u.role !== "customer"; $("drv").hidden = u.role !== "driver";
  if (u.role === "customer") { loadMaps(); renderRides(); }
  const tick = u.role === "customer" ? custPoll : drvPoll;
  tick(); poll = setInterval(tick, 2500);
}

// ---------- خريطة جوجل ----------
async function loadMaps() {
  cfg = await api("/config");
  if (!cfg.mapsKey) { $("map").textContent = "ضيف GOOGLE_MAPS_API_KEY في ملف .env عشان الخريطة تظهر"; return; }
  window.mapsReady = async () => {
    const { Map } = await google.maps.importLibrary("maps");
    ({ Route } = await google.maps.importLibrary("routes"));
    $("map").textContent = "";
    gmap = new Map($("map"), { center: { lat: 30.0444, lng: 31.2357 }, zoom: 11, mapId: cfg.mapId, mapTypeControl: false, streetViewControl: false });
  };
  const s = document.createElement("script");
  s.async = true;
  s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(cfg.mapsKey)}&loading=async&callback=mapsReady&language=ar&region=EG`;
  document.head.appendChild(s);
}

$("calc").onclick = async () => {
  $("cerr").textContent = "";
  if (!Route) { $("cerr").textContent = "الخريطة لسه مش جاهزة"; return; }
  try {
    const { routes } = await Route.computeRoutes({
      origin: $("from").value, destination: $("to").value, travelMode: "DRIVING",
      routingPreference: "TRAFFIC_AWARE", region: "EG", language: "ar",
      fields: ["path", "distanceMeters", "durationMillis", "viewport"],
    });
    if (!routes || !routes.length) throw new Error("مفيش مسار بين النقطتين");
    const r = routes[0];
    lines.forEach((l) => l.setMap(null));
    lines = r.createPolylines(); lines.forEach((l) => l.setMap(gmap));
    gmap.fitBounds(r.viewport);
    route = { km: r.distanceMeters / 1000, mins: Math.round(r.durationMillis / 60000) };
    $("dist").textContent = route.km.toFixed(1) + " كم";
    $("eta").textContent = route.mins + " دقيقة";
    $("req").disabled = false;
    renderRides();
  } catch (e) { $("cerr").textContent = "مقدرتش أحسب المسار: " + e.message; }
};

function renderRides() {
  $("rides").innerHTML = Object.entries(PR).map(([k, v]) =>
    `<div class="card ${k === type ? "on" : ""}" data-t="${k}"><span>${v[3]} <b>${v[2]}</b></span><b>${route ? Math.round(v[0] + v[1] * route.km) + " جنيه" : "—"}</b></div>`).join("");
}
$("rides").onclick = (e) => { const c = e.target.closest("[data-t]"); if (c) { type = c.dataset.t; renderRides(); } };

$("req").onclick = async () => {
  try {
    await api("/rides", "POST", { from: $("from").value, to: $("to").value, km: route.km, mins: route.mins, type });
    custPoll();
  } catch (e) { $("cerr").textContent = e.message; }
};

async function custPoll() {
  try {
    const c = await api("/rides/current");
    $("book").hidden = !!c; $("status").hidden = !c;
    if (!c) return;
    $("status").innerHTML = c.status === "open"
      ? `<h2>بندور على أقرب كابتن…</h2><div class="info"><span>${esc(c.from_text)} ← ${esc(c.to_text)}</span><b>${c.price} جنيه</b></div><button id="cx">إلغاء</button>`
      : `<h2>الكابتن جاي لك 🎉</h2><div class="card"><div><b>${esc(c.driver_name)}</b><div class="info">${esc(c.driver_car)}</div></div><a href="tel:${esc(c.driver_phone)}">📞 اتصل</a></div><div class="info"><span>${esc(c.from_text)} ← ${esc(c.to_text)}</span><b>${c.price} جنيه</b></div><button id="cx">إلغاء الرحلة</button>`;
    $("cx").onclick = async () => { await api(`/rides/${c.id}/cancel`, "POST"); custPoll(); };
  } catch (e) { if (/سجّل/.test(e.message)) $("out").click(); }
}

// ---------- السائق ----------
async function drvPoll() {
  try {
    const s = await api("/driver/state");
    $("earn").textContent = s.earnings + " جنيه";
    if (s.current) {
      const c = s.current;
      $("dl").innerHTML = `<h2>رحلة جارية</h2><div class="card"><div><b>${esc(c.from_text)} ← ${esc(c.to_text)}</b><div class="info">${esc(c.customer_name)} – ${esc(c.customer_phone)}</div></div><b>${c.price} جنيه</b></div><a href="tel:${esc(c.customer_phone)}"><button>📞 اتصل بالعميل</button></a><button class="p" data-f="${c.id}">إنهاء الرحلة</button>`;
    } else {
      $("dl").innerHTML = s.open.length ? s.open.map((r) =>
        `<div class="card"><div><b>${esc(r.from_text)} ← ${esc(r.to_text)}</b><div class="info">${r.km.toFixed(1)} كم – ${r.price} جنيه</div></div><button class="p sm" data-a="${r.id}">قبول</button></div>`).join("")
        : '<p class="info">مفيش طلبات دلوقتي… بنحدّث تلقائيًا</p>';
    }
  } catch (e) { if (/سجّل/.test(e.message)) $("out").click(); }
}
$("drv").onclick = async (e) => {
  const b = e.target.closest("button");
  if (!b) return;
  try {
    if (b.dataset.a) await api(`/rides/${b.dataset.a}/accept`, "POST");
    if (b.dataset.f) await api(`/rides/${b.dataset.f}/finish`, "POST");
    drvPoll();
  } catch (er) { alert(er.message); }
};

// ---------- بداية ----------
tabs();
if (token) api("/me").then(enter).catch(() => { token = null; localStorage.removeItem("tk"); });
</script>
</body>
</html>
